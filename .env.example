# ---------------------------------------------------------------------------
# FoodMe — shared environment file (repo root)
# Copy this file to `.env` (same directory) and fill in the values.
# `infra/docker-compose.yml` loads it via `env_file: ../.env` for every
# service, across all three profiles (core, observability, ci).
# ---------------------------------------------------------------------------

# --- core: postgres -----------------------------------------------------
POSTGRES_DB=foodme
POSTGRES_USER=foodme
POSTGRES_PASSWORD=foodme

# --- core: backend (Spring Boot on 8081, profile "docker") --------------
# Chef/dish pictures are stored in Postgres (foodme.image) and served by the
# backend at /api/images/** — no object-storage service to configure.
SPRING_PROFILES_ACTIVE=docker
DB_HOST=postgres
DB_PORT=5432
DB_NAME=foodme
DB_USER=foodme
DB_PASSWORD=foodme
# GlitchTip DSN for the backend (Sentry-compatible). Obtain after GlitchTip
# is up — see the GLITCHTIP_* section below for the steps.
SENTRY_DSN=

# --- core: web (nginx on 80, published 3000) -----------------------------
# Base URL the SPA calls for the backend API.
VITE_API_BASE_URL=http://localhost:8081
# GlitchTip DSN for the web frontend. Same DSN-retrieval steps as above,
# but create a separate "web" project in GlitchTip so backend/web/admin
# errors don't mix.
VITE_SENTRY_DSN=

# --- core: admin (nginx on 80, published 3001) ---------------------------
# Reuses the same two var names as web; set per-service in compose via
# build args / env, values may differ (e.g. a separate GlitchTip project).
# VITE_API_BASE_URL and VITE_SENTRY_DSN are set again for admin in compose.

# --- observability: Grafana (3002) ---------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- observability: GlitchTip (Sentry-API compatible, 8000) --------------
# GlitchTip needs its own Postgres + Redis + a Django SECRET_KEY.
# DSN retrieval (first run):
#   1. `docker compose -f infra/docker-compose.yml --profile observability up -d`
#   2. Open http://localhost:8000, register the first account
#      (ENABLE_USER_REGISTRATION=true makes the first user an org owner).
#   3. Create an organization + a project per app (backend / web / admin).
#   4. Each project's Settings > "Client Keys (DSN)" page shows the DSN.
#   5. Paste the backend DSN into SENTRY_DSN above, and the frontend DSNs
#      into VITE_SENTRY_DSN for web/admin, then restart the `core` profile
#      so the apps pick up the new .env values.
GLITCHTIP_SECRET_KEY=change-me-to-a-random-string
GLITCHTIP_DATABASE_URL=postgres://glitchtip:glitchtip@glitchtip-postgres:5432/glitchtip
GLITCHTIP_POSTGRES_DB=glitchtip
GLITCHTIP_POSTGRES_USER=glitchtip
GLITCHTIP_POSTGRES_PASSWORD=glitchtip
GLITCHTIP_REDIS_URL=redis://glitchtip-redis:6379/0
GLITCHTIP_DOMAIN=http://localhost:8000
ENABLE_USER_REGISTRATION=true

# --- ci: Jenkins (8080, agent port 50000) ---------------------------------
# JCasC admin user is fixed to admin/admin in infra/jenkins/jenkins.yaml
# (unsecured-but-local, for course use only). No env vars required here,
# but JENKINS_ADMIN_ID / JENKINS_ADMIN_PASSWORD are read by the JCasC file
# so they can be overridden without editing infra/jenkins/jenkins.yaml.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# --- cloud lab (see docs/deployment.md — student copy-paste guide) ------
# On Render, paste the Neon URI as-is (no JDBC conversion needed):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#   FOODME_CORS_ALLOWED_ORIGINS=*
# On Vercel (apps/web and apps/admin), set at build time:
#   VITE_API_BASE_URL=https://your-api.onrender.com


# --- tooling: Qase MCP server (.mcp.json) --------------------------------
# Qase personal API token (https://app.qase.io/user/api/token), used by the
# Qase MCP server to create/upload test cases. Don't put the real value
# here or in .env — keep it in AgentSecrets:
#   agentsecrets secret set QASE_API_TOKEN=<token>
QASE_API_TOKEN=
