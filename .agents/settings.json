{
  "statusLine": {
    "type": "command",
    "command": "bash workflows/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/check-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/block_bad_waits.py"
          }
        ]
      }
    ]
  }
}
